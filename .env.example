# Copy to .env in the repo root. Both examples read it. Real environment variables win.

# API key created by the account owner at https://send21.io/api-keys
# The MCP payment request example needs the drafts:write scope.
SEND21_API_KEY=

# Optional default receiving options for the pay link, comma separated, as
# Currency:Network:Address[:Method]. Use your own addresses. Example:
# SEND21_PAY_OPTIONS=Usdc:Solana:<your-solana-address>,Eth:Base:<your-base-address>,Btc:Mainnet:name@wallet.com:Lightning
SEND21_PAY_OPTIONS=

# Optional, defaults to https://send21.io/mcp
# SEND21_MCP_URL=https://send21.io/mcp

# Webhook signing secret, returned once when you create the webhook endpoint
SEND21_WEBHOOK_SECRET=

# Port for the webhook receiver
PORT=3000
