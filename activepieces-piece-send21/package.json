{
  "name": "activepieces-piece-send21",
  "version": "0.1.0",
  "description": "Activepieces piece for send21: crypto pay links and payment drafts. A flow prepares them; a person signs and sends from their own wallet. send21 never holds keys or funds.",
  "license": "MIT",
  "author": {
    "name": "send21",
    "email": "info@send21.io",
    "url": "https://send21.io"
  },
  "homepage": "https://send21.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/send21io/send21-examples.git",
    "directory": "activepieces-piece-send21"
  },
  "bugs": {
    "email": "info@send21.io",
    "url": "https://github.com/send21io/send21-examples/issues"
  },
  "keywords": [
    "activepieces",
    "activepieces-piece",
    "send21",
    "crypto",
    "payments",
    "bitcoin",
    "usdc",
    "lightning",
    "non-custodial"
  ],
  "main": "./src/index.js",
  "files": [
    "src/index.js",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "test": "node --test test/*.test.cjs",
    "prepublishOnly": "echo 'Publish the bundled dist/ folder: npm run publish:npm' && exit 1",
    "publish:npm": "npm run build && npm test && npm publish ./dist --access public"
  },
  "devDependencies": {
    "@activepieces/pieces-common": "^0.12.5",
    "@activepieces/pieces-framework": "^0.32.0",
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
