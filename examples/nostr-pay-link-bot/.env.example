# Bot key: run `node keygen.js >> .env` once. Never commit .env.
NOSTR_SECRET_KEY=
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net

# send21 key with drafts:read and drafts:write. It creates pay links; it cannot move funds.
SEND21_API_KEY=
SEND21_WEBHOOK_SECRET=
SEND21_OPTIONS=[{"currency":"Btc","network":"Mainnet","address":"you@your-wallet.com","method":"Lightning"},{"currency":"Usdc","network":"Base","address":"0xYourAddress"}]
SEND21_DECLINE_NOTE=
SEND21_EXPIRY_HOURS=24

# What payers can ask for. They cannot pick an amount or an address.
BOT_MENU={"coffee":{"amount":5,"currency":"EUR","label":"A coffee"},"sticker-pack":{"amount":12,"currency":"EUR","label":"Sticker pack"}}

PORT=8791
STORE_PATH=./nostr-bot-state.json
