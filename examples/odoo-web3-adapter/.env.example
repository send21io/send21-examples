# send21 key with drafts:read and drafts:write. It prepares pay links and drafts; it cannot move funds.
SEND21_API_KEY=
SEND21_WEBHOOK_SECRET=
# EVM tokens only, so odoo-web3 can sync the transfers (Usdc/Usdt/Eurc on Ethereum, Base, Arbitrum, Polygon)
SEND21_OPTIONS=[{"currency":"Eurc","network":"Base","address":"0x0000000000000000000000000000000000000000"}]
SEND21_DECLINE_NOTE=
SEND21_EXPIRY_HOURS=24

# Same Odoo settings as odoo-web3
ODOO_URL=https://your-odoo.example.com
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_PASSWORD=
# The bank journal odoo-web3 syncs this wallet into
ODOO_JOURNAL_ID=

PORT=8790
STORE_PATH=./send21-odoo-web3.json
