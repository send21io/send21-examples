# Scoped key from https://send21.io/api-keys (drafts:write, drafts:read). It cannot move funds.
SEND21_API_KEY=

# At least one approved receiving address (live networks; the demo at https://send21.io/demo is testnet only).
MY_SOLANA_ADDRESS=
MY_BASE_ADDRESS=
MY_LIGHTNING_ADDRESS=

# Optional model for the agent run. The tools-only and dry-run paths need no model key.
# OPENAI_API_KEY=
# SEND21_MODEL=openai:gpt-4.1-mini
