# Leave SEND21_API_KEY empty (or set DRY_RUN=1) for mock mode: no key, nothing sent to send21.
DRY_RUN=
PORT=5930

# Scoped key from https://send21.io/api-keys. drafts:write creates pay links,
# drafts:read lets the status endpoint read them. No send21 key can move funds.
SEND21_API_KEY=
SEND21_API_BASE=https://send21.io

# Signing secret returned once when you register the webhook endpoint
# (https://send21.io/webhooks or POST /api/v1/webhooks with webhooks:manage).
SEND21_WEBHOOK_SECRET=

# Your own receive addresses, fixed on the server: Currency:Network:Address[:Method], comma separated.
# USDT only on Solana and Ethereum.
SEND21_OPTIONS=Usdc:Solana:<your-solana-address>,Usdt:Solana:<your-solana-address>,Usdt:Ethereum:<your-ethereum-address>,Btc:Mainnet:name@wallet.com:Lightning

SHOP_CURRENCY=EUR
SEND21_EXPIRY_HOURS=1
# 1 = mark an order paid when the receiver accepted a different amount on send21. Default: hold for review.
ACCEPT_DIFFERENT_AMOUNT=
# Public URL of this server (used for mock pay links); optional.
PUBLIC_URL=
# Where orders and seen delivery ids are stored. Empty string = memory only.
# DATA_FILE=./data/orders.json
