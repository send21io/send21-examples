# send21 key with drafts:read and drafts:write. It can create pay links; it cannot move funds.
SEND21_API_KEY=
# Signing secret returned once by POST /api/v1/webhooks
SEND21_WEBHOOK_SECRET=
# Your receiving options (approved addresses in send21)
SEND21_OPTIONS=[{"currency":"Usdc","network":"Base","address":"0xYourAddress"},{"currency":"Btc","network":"Mainnet","address":"you@your-wallet.com","method":"Lightning"}]
# Optional: shown on the pay page as "If you don't pay:" (plain text, max 200 characters)
SEND21_DECLINE_NOTE=
# Optional: 1 to 720, default 24
SEND21_EXPIRY_HOURS=

INVOICENINJA_URL=https://invoicing.example.com
INVOICENINJA_TOKEN=
# Any long random string; add it as the X-Webhook-Token header on the Invoice Ninja webhook
INVOICENINJA_WEBHOOK_TOKEN=
# Optional: company currency code if all clients use one; otherwise looked up per client
INVOICENINJA_CURRENCY=
# Invoice custom field that holds the pay link (custom_value1 .. custom_value4)
INVOICENINJA_LINK_FIELD=custom_value1
PORT=8787
STORE_PATH=./send21-invoiceninja.json
