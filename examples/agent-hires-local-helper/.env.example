# Copy to .env in this folder. Real environment variables win. Never commit .env.

# Scoped key from https://send21.io/api-keys, used by the agent (MCP and REST).
# drafts:write and drafts:read create and read the draft; addressbook:read lets the
# agent check that the helper's address is one you approved. No key can move funds.
SEND21_API_KEY=

# Optional, defaults to https://send21.io/mcp
# SEND21_MCP_URL=https://send21.io/mcp
# HELPER_FILE=helper.json
PORT=3022

# Optional: signing secret of a webhook endpoint (POST /api/v1/webhooks, scope webhooks:manage)
# pointing at https://<your-public-host>/webhooks/send21, for the draft.confirmed event.
SEND21_WEBHOOK_SECRET=

# Optional, local only: lets `npm run local-paid` sign a test delivery so you can see the
# "Paid" screen without a real payment. The UI labels it as a local test.
# LOCAL_TEST_WEBHOOK_SECRET=
