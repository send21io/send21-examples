# send21 API key (s21_...) from https://send21.io/api-keys
# scopes: drafts:write, drafts:read, addressbook:read (+ addressbook:write to propose addresses, webhooks:manage to register)
SEND21_API_KEY=s21_your_key
# YOUR receiving addresses, approved by you in the send21 app. USDT only on Solana and Ethereum.
SEND21_RECEIVE_OPTIONS=[{"currency":"Usdc","network":"Solana","address":"YourSolanaAddress"},{"currency":"Usdt","network":"Solana","address":"YourSolanaAddress"}]
# returned once by: python webhook_server.py --register https://your-host/send21/webhook
SEND21_WEBHOOK_SECRET=
# optional: email the link (otherwise it is printed)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=invoices@example.com
# optional: free-text intake, e.g. openai:gpt-4.1-mini (needs langchain + the provider package and its key)
SEND21_LLM_MODEL=
